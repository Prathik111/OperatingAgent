# Local development environment for OperatingAgent.
# Copy this file to .env and fill in only the values you need.
#
# Everything here is a safe local default. Fill in the credentials you actually
# need; blank values mean "feature disabled", never "broken".

# ---------------------------------------------------------------------------
# Langfuse tracing (packages/observability)
# ---------------------------------------------------------------------------
# Blank -> LangfuseSettings.enabled is False and the agent runs untraced.
# Paste your keys from Langfuse: Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=

# ---------------------------------------------------------------------------
# HTTP API
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=info
# Omit this to select postgres when DATABASE_URL is set, otherwise memory.
# API_REPOSITORY_BACKEND=memory
# DATABASE_URL=postgresql://user:password@localhost:5432/operating_agent
# Tauri production origins plus the conventional Vite development server.
# Replace/add the exact dev URL if the frontend uses a different port.
API_CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420,http://127.0.0.1:1420
# Host-header allowlist for the loopback API. Add a host only when intentionally
# exposing the backend beyond localhost.
API_ALLOWED_HOSTS=127.0.0.1,localhost
API_DEFAULT_TRACK=langgraph
API_APPROVAL_THRESHOLD=review

# ---------------------------------------------------------------------------
# MCP tool gateway (stdio; launched automatically by the LangGraph agent)
# ---------------------------------------------------------------------------
# Defaults to the active Python interpreter and ``python -m gateway_server``.
# MCP_GATEWAY_COMMAND=
# MCP_GATEWAY_ARGS=-m gateway_server

# ---------------------------------------------------------------------------
# Canonical PostgreSQL store (infra/docker/docker-compose.yml)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://agent_native:agent_native@localhost:5433/agent_native

# ---------------------------------------------------------------------------
# MCP servers (packages/mcp-servers) — both are read at import time.
# ---------------------------------------------------------------------------
# Confines every file-server path to this directory. Keep it set: unset means
# the server's CWD, i.e. the entire repository, is readable and writable.
FILE_SERVER_ROOT=./workspace

# Executable allowlist for terminal-server (authorization, not sandboxing).
TERMINAL_SERVER_ALLOWED_COMMANDS=cat,dir,echo,grep,head,ls,pwd,tail,tree,type,uv,wc,where,which

# ---------------------------------------------------------------------------
# Model providers — only the provider named in AgentConfig.llm.provider needs a key
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
# LLM_BASE_URL overrides a provider-specific base URL.
# LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=
LLM_TOP_P=1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Agent execution and behavior
AGENT_MAX_ITERATIONS=20
AGENT_EXECUTION_TIMEOUT_SECONDS=300
AGENT_RETRY_ATTEMPTS=2
AGENT_STREAM=true
AGENT_ENABLE_CHECKPOINTS=true
AGENT_ENABLE_INTERRUPTS=true
AGENT_REQUIRE_VERIFICATION=false
AGENT_REQUIRE_HUMAN_APPROVAL=true

# Tool authorization and filesystem confinement
AGENT_SANDBOX_ENABLED=true
AGENT_WORKSPACE=./workspace
AGENT_PERMISSION_FILE_SYSTEM=true
AGENT_PERMISSION_TERMINAL=true
AGENT_PERMISSION_GIT=true
AGENT_PERMISSION_SEARCH=true
AGENT_PERMISSION_KNOWLEDGE=true
AGENT_PERMISSION_MEMORY=true

# Checkpoints and prompts
AGENT_CHECKPOINT_BACKEND=auto
AGENT_CHECKPOINT_NAMESPACE=default
# Defaults to the prompts packaged with agent-langgraph.
# AGENT_PROMPT_DIR=
# AGENT_PLANNER_PROMPT=
# AGENT_VERIFIER_PROMPT=
# AGENT_RESPONDER_PROMPT=
