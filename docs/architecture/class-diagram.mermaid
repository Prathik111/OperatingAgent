classDiagram
    direction LR

    %% =========================================================
    %% packages/common — shared contracts only
    %% =========================================================
    class TrackType {
        <<enumeration>>
        NATIVE
        LANGGRAPH
    }
    class TaskStatus {
        <<enumeration>>
        CREATED
        RUNNING
        COMPLETED
        FAILED
        INTERRUPTED
    }
    class StepStatus {
        <<enumeration>>
        PENDING
        RUNNING
        DONE
        FAILED
        BLOCKED
    }
    class RiskLevel {
        <<enumeration>>
        SAFE
        RISKY
        BLOCKED
    }
    class AgentEvent {
        <<enumeration>>
        TASK_STARTED
        TASK_PROGRESS
        TOOL_REQUESTED
        TOOL_COMPLETED
        TASK_COMPLETED
        TASK_FAILED
    }

    class LLMConfig {
        +provider : str
        +model : str
        +temperature : float
        +max_tokens : int
        +top_p : float
        +base_url : str
    }
    class ExecutionConfig {
        +max_steps : int
        +timeouts : dict
        +retry_attempts : int
        +stream : bool
    }
    class SandboxConfig {
        +enabled : bool
        +image : str
        +network_enabled : bool
        +memory_limit_mb : int
        +cpu_limit : float
    }
    class CheckpointConfig {
        +backend : str
        +namespace : str
        +connection_string : str
    }
    class TracingConfig {
        +enabled : bool
        +provider : str
        +project_name : str
    }
    class AgentConfig {
        +llm : LLMConfig
        +execution : ExecutionConfig
        +sandbox : SandboxConfig
        +checkpoint : CheckpointConfig
        +tracing : TracingConfig
    }

    class AgentTask {
        +id : str
        +thread_id : str
        +goal : str
        +track : TrackType
        +attachments : list
        +metadata : dict
        +created_at : datetime
    }
    class ToolCallRequest {
        +tool_name : str
        +arguments : dict
    }
    class ToolCallResult {
        +success : bool
        +output : str
        +error : str
    }
    class ToolInfo {
        +name : str
        +description : str
        +input_schema : dict
        +output_schema : dict
        +risk_level : RiskLevel
    }
    class AgentRunResult {
        +status : TaskStatus
        +output : str
        +steps_taken : int
        +tool_calls : int
        +llm_calls : int
        +tokens_used : int
        +latency_s : float
    }
    class IMCPClient {
        <<interface>>
        +list_tools() ToolInfo[]
        +call_tool(request ToolCallRequest) ToolCallResult
    }
    class RiskClassifier {
        +classify(call ToolCallRequest) RiskLevel
        -patterns : list
    }
    class IAgentOrchestrator {
        <<interface>>
        +run(task AgentTask, on_event Callable) AgentRunResult
    }
    class ApprovalRequest {
        +id : str
        +task_id : str
        +tool_name : str
        +arguments : dict
        +risk_level : RiskLevel
    }

    RiskClassifier ..> RiskLevel : returns
    RiskClassifier ..> ToolCallRequest : inspects
    IAgentOrchestrator ..> AgentTask : consumes
    IAgentOrchestrator ..> AgentRunResult : returns

    %% =========================================================
    %% packages/agent-native — Plan-and-Execute + ReAct (hand-written)
    %% =========================================================
    class NativeAgent {
        -planner : Planner
        -executor : ReactExecutor
        -reflector : Reflector
        -verifier : Verifier
        -compactor : ContextCompactor
        -mcp_client : NativeMCPClient
        +run(task, on_event) AgentRunResult
    }
    class NativePlan {
        +task_id : str
        +steps : NativePlanStep[]
    }
    class NativePlanStep {
        +id : str
        +description : str
        +tool_name : str
        +status : StepStatus
    }
    class Planner {
        +plan(goal str) NativePlan
    }
    class ReactExecutor {
        -max_calls_per_step : int
        +execute_step(step NativePlanStep) Observation
    }
    class Reflector {
        +replan(plan NativePlan, failure str) NativePlan
    }
    class Verifier {
        +verify(step NativePlanStep, result ToolCallResult) bool
    }
    class ContextCompactor {
        -token_budget : int
        +check_budget(history) bool
        +compact(history) str
    }
    class NativeMCPClient {
        +list_tools() ToolInfo[]
        +call_tool(request ToolCallRequest) ToolCallResult
    }

    IAgentOrchestrator <|.. NativeAgent
    IMCPClient <|.. NativeMCPClient
    NativeAgent *-- Planner
    NativeAgent *-- ReactExecutor
    NativeAgent *-- Reflector
    NativeAgent *-- Verifier
    NativeAgent *-- ContextCompactor
    NativeAgent --> NativeMCPClient
    ReactExecutor --> RiskClassifier : checks before execution
    ReactExecutor ..> ToolCallRequest : builds
    Verifier ..> ToolCallResult : inspects
    Planner ..> NativePlan : produces
    NativePlan "1" *-- "many" NativePlanStep

    %% =========================================================
    %% packages/agent-langgraph — layered LangGraph architecture
    %% =========================================================
    class LangGraphAgent {
        -config : AgentConfig
        -runtime : AgentRuntime
        -checkpointer : BaseCheckpointSaver
        -graph : CompiledStateGraph
        +run(task)
        +stream(task)
    }
    class LangGraphPlan {
        +task_id : str
        +steps : LangGraphPlanStep[]
    }
    class LangGraphPlanStep {
        +id : str
        +description : str
        +tool_name : str
        +status : StepStatus
    }
    class AgentState {
        <<TypedDict>>
        +messages : list
        +goal : str
        +plan : LangGraphPlan?
        +current_step : str
        +completed_steps : list
        +tool_results : dict
        +retry_count : int
        +status : TaskStatus
    }
    class AgentRuntime {
        +model_provider : ModelProvider
        +tool_registry : ToolRegistry
        +sandbox : SandboxManager
        +tracer : TracingService
        +prompt_manager : PromptManager
        +config : AgentConfig
    }
    class GraphFactory {
        +create_state_graph() StateGraph
        +register_nodes(graph) void
        +register_edges(graph) void
        +register_conditional_edges(graph) void
        +build(checkpointer) CompiledStateGraph
    }
    class CompiledStateGraph {
        <<library>>
        +invoke(state, context) AgentState
        +ainvoke(state, context) AgentState
        +stream(state, context) Iterator
        +astream(state, context) AsyncIterator
        +get_state(config) AgentState
        +update_state(config, values) void
    }
    class PlannerNode {
        +__call__(state AgentState, runtime AgentRuntime) AgentState
    }
    class ExecutorNode {
        +__call__(state AgentState, runtime AgentRuntime) AgentState
    }
    class VerifierNode {
        +__call__(state AgentState, runtime AgentRuntime) AgentState
    }
    class ResponderNode {
        +__call__(state AgentState, runtime AgentRuntime) AgentState
    }
    class ErrorHandlerNode {
        +__call__(state AgentState, runtime AgentRuntime) AgentState
    }
    class MCPAdapter {
        +list_tools() ToolInfo[]
        +call_tool(request ToolCallRequest) ToolCallResult
    }
    class BaseCheckpointSaver {
        <<abstract>>
    }
    class MemorySaver {
        <<library>>
    }
    class PostgresSaver {
        <<library>>
    }
    class ToolRegistry {
        +list_tools() ToolInfo[]
        +get_tool(name) ToolInfo
        +call_tool(request ToolCallRequest) ToolCallResult
    }
    class ModelProvider {
        +generate(prompt) str
        +stream(prompt) Iterator
    }
    class TracingService {
        +start_span(name) Span
        +end_span(span) void
    }
    class PromptManager {
        +planner_prompt()
        +verifier_prompt()
        +responder_prompt()
    }

    IAgentOrchestrator <|.. LangGraphAgent
    IMCPClient <|.. MCPAdapter
    BaseCheckpointSaver <|-- MemorySaver
    BaseCheckpointSaver <|-- PostgresSaver

    LangGraphAgent *-- AgentRuntime
    LangGraphAgent *-- BaseCheckpointSaver : checkpointer (PostgresSaver prod, MemorySaver dev)
    LangGraphAgent *-- CompiledStateGraph
    LangGraphAgent *-- GraphFactory

    AgentRuntime *-- ToolRegistry
    AgentRuntime *-- ModelProvider
    AgentRuntime *-- TracingService
    AgentRuntime *-- SandboxManager
    AgentRuntime --> AgentConfig
    AgentRuntime *-- PromptManager

    ToolRegistry --> MCPAdapter
    ExecutorNode --> ToolRegistry
    ExecutorNode --> RiskClassifier : checks before execution

    LangGraphAgent ..> CompiledStateGraph : ainvoke(state, context=runtime)
    GraphFactory ..> BaseCheckpointSaver : build(graph, checkpointer) param
    GraphFactory ..> CompiledStateGraph : returns
    GraphFactory ..> PlannerNode : registers
    GraphFactory ..> ExecutorNode : registers
    GraphFactory ..> VerifierNode : registers
    GraphFactory ..> ResponderNode : registers
    GraphFactory ..> ErrorHandlerNode : registers
    GraphFactory ..> AgentState : uses schema
    GraphFactory ..> AgentRuntime : wires runtime into nodes

    PlannerNode ..> AgentState : reads/writes
    ExecutorNode ..> AgentState : reads/writes
    VerifierNode ..> AgentState : reads/writes
    ResponderNode ..> AgentState : reads/writes
    ErrorHandlerNode ..> AgentState : reads/writes

    PlannerNode ..> AgentRuntime : receives per call
    ExecutorNode ..> AgentRuntime : receives per call
    VerifierNode ..> AgentRuntime : receives per call
    ResponderNode ..> AgentRuntime : receives per call
    ErrorHandlerNode ..> AgentRuntime : receives per call

    PlannerNode ..> LangGraphPlan : produces
    AgentState --> LangGraphPlan
    LangGraphPlan "1" *-- "many" LangGraphPlanStep

    %% =========================================================
    %% packages/mcp-servers — fastmcp servers
    %% =========================================================
    class GatewayServer {
        +mcp : FastMCP
        +mount_subservers() void
        +list_tools() ToolInfo[]
        +call_tool(request ToolCallRequest) ToolCallResult
    }
    class FastMCPServer {
        <<FastMCP>>
        +tool(fn) void
        +mount(server FastMCP, prefix str) void
        +run(transport str) void
    }
    class FileServer {
        +mcp : FastMCP
        +read_file(path) ToolCallResult
        +write_file(path, content) ToolCallResult
        +list_directory(path) ToolCallResult
        +create_directory(path) ToolCallResult
        +copy_file(source, target) ToolCallResult
        +move_file(source, target) ToolCallResult
        +rename_file(path, name) ToolCallResult
        +delete_file(path) ToolCallResult
        +delete_directory(path) ToolCallResult
        +exists(path) ToolCallResult
        +metadata(path) ToolCallResult
        +search_files(query) ToolCallResult
        +watch_directory(path) ToolCallResult
    }
    class TerminalServer {
        +mcp : FastMCP
        +run_command(cmd) ToolCallResult
        +list_processes() ToolCallResult
    }
    class GitServer {
        +mcp : FastMCP
        +git_status() ToolCallResult
        +diff() ToolCallResult
        +git_log() ToolCallResult
        +list_branches() ToolCallResult
    }
    class SearchServer {
        +mcp : FastMCP
        +index_documents(path) ToolCallResult
        +list_indices() ToolCallResult
        +search_documents(query) ToolCallResult
    }
    class KnowledgeServer {
        +mcp : FastMCP
        +query_rag(question) str
    }
    class MemoryServer {
        +mcp : FastMCP
        +store_memory(entry) void
        +retrieve_memory(query) MemoryEntry[]
    }
    class FilesystemService {
        +resolve_path(path) Path
        +read(path) str
        +write(path, content) void
        +list(path) list
        +delete(path) void
    }
    class TerminalService {
        +run(cmd) ToolCallResult
        +list_processes() list
    }
    class GitService {
        +status() str
        +diff() str
        +log() str
        +branches() list
    }
    class SearchService {
        +index(path) void
        +list_indices() list
        +search(query) SearchResult[]
    }

    GatewayServer --> FastMCPServer : owns gateway app
    GatewayServer o-- FileServer : mounts prefix file
    GatewayServer o-- TerminalServer : mounts prefix terminal
    GatewayServer o-- GitServer : mounts prefix git
    GatewayServer o-- SearchServer : mounts prefix search
    GatewayServer o-- KnowledgeServer : mounts prefix knowledge
    GatewayServer o-- MemoryServer : mounts prefix memory

    FileServer --> FastMCPServer : exposes tools
    TerminalServer --> FastMCPServer : exposes tools
    GitServer --> FastMCPServer : exposes tools
    SearchServer --> FastMCPServer : exposes tools
    KnowledgeServer --> FastMCPServer : exposes tools
    MemoryServer --> FastMCPServer : exposes tools

    FileServer --> FilesystemService
    TerminalServer --> TerminalService
    GitServer --> GitService
    SearchServer --> SearchService

    NativeMCPClient ..> GatewayServer : MCP protocol
    MCPAdapter ..> GatewayServer : MCP protocol

    %% =========================================================
    %% packages/sandbox
    %% =========================================================
    class SandboxManager {
        +create_session(task_id) SandboxSession
        +destroy_session(id) void
    }
    class SandboxSession {
        +container_id : str
        +workspace_path : str
        +cpu_limit : str
        +time_limit_s : int
        +run(cmd) ToolCallResult
    }
    SandboxManager *-- SandboxSession
    TerminalServer --> SandboxManager : executes inside
    FileServer --> SandboxManager : scoped to workspace
    GitServer --> SandboxManager : scoped to workspace

    %% =========================================================
    %% packages/observability
    %% =========================================================
    class LangfuseExporter {
        +export_trace(spans) void
    }
    TracingService --> LangfuseExporter
    NativeAgent --> TracingService : instrumented by
    LangGraphAgent --> TracingService : instrumented by

    %% =========================================================
    %% packages/evaluation
    %% =========================================================
    class BenchmarkRunner {
        +run_suite(tasks TaskCase[], orchestrator IAgentOrchestrator) EvaluationResult[]
    }
    class TaskCase {
        +id : str
        +category : str
        +goal : str
        +expected_outcome : str
    }
    class EvaluationResult {
        +task_id : str
        +track : TrackType
        +success : bool
        +steps : int
        +latency_s : float
        +tokens : int
    }
    class SafetyClassifierEvaluator {
        +evaluate(classifier RiskClassifier, labeled_set) PrecisionRecall
    }

    BenchmarkRunner --> IAgentOrchestrator : drives
    BenchmarkRunner --> TaskCase : reads
    BenchmarkRunner ..> EvaluationResult : produces
    BenchmarkRunner --> SafetyClassifierEvaluator

    %% =========================================================
    %% packages/api — FastAPI
    %% =========================================================
    class TaskService {
        -orchestrators : dict~TrackType, IAgentOrchestrator~
        +create_task(goal, track) AgentTask
        +get_task(id) AgentTask
        +stream_task(id) AsyncIterator
    }
    class ApprovalGateway {
        +request_approval(request ApprovalRequest) void
        +resolve_approval(request_id, approved bool) void
    }
    class TaskRepository {
        +save(task AgentTask) void
        +get(id) AgentTask
        +log_metrics(result EvaluationResult) void
    }
    class TaskRouter {
        +post_task(goal, track) AgentTask
        +get_task(id) AgentTask
    }
    class TaskStreamSocket {
        +on_connect(task_id) void
        +push_event(event) void
    }

    TaskService --> IAgentOrchestrator : dispatches to native or langgraph
    TaskService --> TaskRepository
    TaskService --> ApprovalGateway
    ApprovalGateway --> RiskClassifier
    ApprovalGateway ..> ApprovalRequest : receives
    TaskRouter --> TaskService
    TaskStreamSocket --> TaskService
    TaskRepository --> AgentTask
    TaskRepository --> AgentRunResult : tracks current status here, not on AgentTask
    TaskRepository --> EvaluationResult
