flowchart TD
    STARTUP["Application Startup"] --> ORCH_READY["LangGraphAgent.__init__()\ncreates AgentRuntime + PostgresSaver/MemorySaver\nGraphFactory.build(checkpointer)\nCompiles one reusable graph"]
    ORCH_READY --> CGRAPH["CompiledStateGraph (singleton per process)"]

    A["User Goal\n(apps/desktop + apps/frontend)"] --> B["POST /tasks\npackages/api → TaskService"]
    B --> TASK["Create AgentTask\n(thread_id, goal, track)"]
    TASK --> C{"track?"}

    C -->|native| D1["agent-native:\nPlan-and-Execute + ReAct"]
    C -->|langgraph| D2["agent-langgraph:\nIAgentOrchestrator → LangGraphAgent"]

    %% Native path
    D1 --> E["Context Collection\n(memory-server + knowledge-server via MCP)"]
    E --> F["ReAct Execution Loop\nThought → Action → Observation"]
    F --> G{"Context budget near limit?"}
    G -->|yes| G1["Compact / summarize history\n(ContextCompactor)"] --> H
    G -->|no| H{"Risk classification\n(common/RiskClassifier)"}
    H -->|risky| I["User Approval requested\nvia WebSocket (ApprovalGateway)"]
    H -->|safe| J["MCP Tool Execution\nNativeMCPClient -> gateway-server\n-> mounted FastMCP subserver"]
    I -->|approved| J
    I -->|denied| K["Abort step → Reflector re-plans"]
    J --> L{"Verification\n(exit code / file exists / build-test)"}
    L -->|fail| M["Reflection: re-plan remaining steps"] --> F
    L -->|pass| N["Log metrics + trace\n(Postgres via TaskRepository,\nOpenTelemetry → Langfuse)"]
    N --> O{"More steps in plan?"}
    O -->|yes| F
    O -->|no| P["Task Completed\nfinal result streamed to frontend"]
    K --> O

    %% LangGraph path
    D2 --> D2A["AgentRuntime + CompiledStateGraph\nalready prepared at startup"]
    D2A --> D2B["Create AgentState from AgentTask\n(and thread_id)"]
    D2B --> D2C["CompiledStateGraph.ainvoke(\nstate,\ncontext=runtime,\nconfig.thread_id)"]
    D2C --> D2P["(LangGraph-internal)\nPregel execution engine"]
    D2P --> D2PN["PlannerNode"]
    D2PN --> D2R1{"conditional edge\nshould_continue / should_retry"}

    D2R1 -->|next| D2EN["ExecutorNode"]
    D2EN --> D2RISK{"Risk classification"}

    D2RISK -->|risky| D2APP["ApprovalGateway"]
    D2RISK -->|safe| D2MCP["ToolRegistry -> MCPAdapter\n-> gateway-server"]

    D2APP -->|approved| D2MCP
    D2APP -->|denied| D2REPLAN["ErrorHandler / Reflector"] --> D2PN

    D2MCP --> D2GW["FastMCP gateway routes by path/prefix\nfile / terminal / git / search\nknowledge / memory later"]
    D2GW --> D2SBX["Mounted subserver executes tool\nfile/terminal/git can use SandboxManager"]
    D2SBX --> D2VN["VerifierNode"]
    D2VN --> D2R2{"More work?"}
    D2R2 -->|yes| D2PN
    D2R2 -->|no| D2RN["ResponderNode → AgentRunResult"]
    D2RN --> P

    style A fill:#DCE6F5,stroke:#1F3864
    style P fill:#DCE6F5,stroke:#1F3864
    style H fill:#FDECC8,stroke:#8A6D3B
    style L fill:#FDECC8,stroke:#8A6D3B
    style D2P fill:#F5F5F5,stroke:#999999,stroke-dasharray: 4 3
