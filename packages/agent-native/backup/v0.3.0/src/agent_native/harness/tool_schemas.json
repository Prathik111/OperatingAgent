{
  "tools": [
    {
      "name": "read_file",
      "description": "Read the complete contents of a file",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "description": "Absolute path to the file"}
        },
        "required": ["path"]
      },
      "riskLevel": "safe"
    },
    {
      "name": "write_file",
      "description": "Create or overwrite a file with given content",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "description": "Absolute path to the file"},
          "content": {"type": "string", "description": "Full content to write"}
        },
        "required": ["path", "content"]
      },
      "riskLevel": "review"
    },
    {
      "name": "exists",
      "description": "Check whether a file or directory exists",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "description": "Absolute path"}
        },
        "required": ["path"]
      },
      "riskLevel": "safe"
    },
    {
      "name": "list_directory",
      "description": "List entries in a directory",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "description": "Absolute directory path"}
        },
        "required": ["path"]
      },
      "riskLevel": "safe"
    },
    {
      "name": "delete_file",
      "description": "Permanently delete a file",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "description": "Absolute path to the file"}
        },
        "required": ["path"]
      },
      "riskLevel": "review"
    },
    {
      "name": "search_files",
      "description": "Search for files matching a glob/filename pattern in a directory tree",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "description": "Root directory to search"},
          "pattern": {"type": "string", "description": "Filename pattern, e.g. *.md"}
        },
        "required": ["path", "pattern"]
      },
      "riskLevel": "safe"
    },
    {
      "name": "metadata",
      "description": "Get size, mtime and type of a file or directory",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "description": "Absolute path"}
        },
        "required": ["path"]
      },
      "riskLevel": "safe"
    },
    {
      "name": "move_file",
      "description": "Move (rename) a file to a new path",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": {"type": "string"},
          "destination": {"type": "string"}
        },
        "required": ["source", "destination"]
      },
      "riskLevel": "review"
    }
  ],
  "scenarios": [
    {"tool": "read_file", "prompt": "Read the contents of the file C:\\work\\notes.md and report what it says about the project."},
    {"tool": "write_file", "prompt": "Create a new file at /work/out/KPI.txt containing 'Q3 targets met'."},
    {"tool": "list_directory", "prompt": "List what files are inside the /work/docs directory."},
    {"tool": "exists", "prompt": "Check whether a file named report.pdf exists in /work/out."},
    {"tool": "search_files", "prompt": "Find every .md file inside /work/notes using a recursive search."},
    {"tool": "metadata", "prompt": "What is the size and last-modified time of /work/config.json?"},
    {"tool": "move_file", "prompt": "Rename /work/tmp/inbox.txt to /work/tmp/processed.txt by moving it."},
    {"tool": "delete_file", "prompt": "Delete the leftover log file /work/tmp/debug.log to clean up."}
  ]
}